# admin-service/.env.example
# Copia a .env y completa valores. NO subas .env al repo.

# App
PORT=3000
NODE_ENV=development

# DB (usadas por app.module en runtime)
DB_HOST=postgres-admin-service
DB_PORT=5432
DB_USER=postgres
DB_PASS=changeme
DB_NAME=admin_service_db
# NOTA: el CLI de migraciones (database.config.ts) lee DATABASE_HOST/PORT/USER/PASSWORD/NAME.

# Auth — mismo valor que el resto de microservicios. Obligatorio en producción.
JWT_SECRET=
# JWT_EXPIRATION=24h

# Servicios externos (incluir el esquema http://)
LOAN_SERVICE_URL=http://loan-service:3001
USER_SERVICE_URL=http://user-service:3000
# Circuit breaker hacia user-service
PROFILE_TIMEOUT_MS=5000
PROFILE_RESET_MS=10000

# CORS
CORS_ORIGINS=http://localhost:3004,http://localhost:3005

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
